# Google OAuth Client ID (see src/pages/Login.tsx). Reuses the same Client ID
# as hkfin/frontend/.env since both sign into the shared `users` table — just
# add this app's origin (dev: http://localhost:5173, prod: your Vercel domain)
# to that Client ID's "Authorized JavaScript origins" in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id-here.apps.googleusercontent.com

# Backend API base URL. Leave unset for local dev (Vite proxies /api to
# localhost:4000, see vite.config.ts). Set this on Vercel to your deployed
# backend's URL, e.g. https://your-backend.onrender.com/api
VITE_API_URL=

# URL of the hkfin frontend, used only for the "go log in on hkfin" link on
# the Login page. Optional — leave blank to hide the link.
VITE_HKFIN_URL="http://localhost:3000"
