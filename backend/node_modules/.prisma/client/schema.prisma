// This DB is shared with hkfin (Supabase Postgres) — hkfin owns `users` and
// everything outside the trading_* / trade_* tables below. Never run
// `prisma migrate` here: it would try to create/alter tables (starting with
// `users`) that this app doesn't own and only partially models. Schema
// changes to the trading tables go through raw SQL migrations in
// D:\hkfin\agent\migrations (see 004_trading_journal.sql), same as the rest
// of hkfin's schema; run `npm run prisma:pull` afterwards to resync this
// file, then `npm run prisma:generate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shared identity table (Supabase Postgres), migrated by hkfin
// (D:\hkfin\agent\migrations) — never run `prisma migrate` against it, it
// already has more columns than this model claims (token_balance, username,
// password_hash...). Trading Journal now has its own Google sign-in (see
// routes/auth.ts) that creates/updates rows here directly, matched by email,
// so one Google account works on both apps and both issue interchangeable
// JWTs (same secret, same {sub,id,role,exp} payload — see middleware/auth.ts).
model User {
  id        BigInt   @id @default(autoincrement())
  email     String   @unique
  name      String
  picture   String?
  provider  String   @default("local")
  role      String?
  createdAt DateTime @default(now()) @map("created_at")

  tradingAccounts TradingAccount[]
  trades          Trade[]
  errorTags       TradeErrorTag[]
  profileSettings TradingProfileSettings?
  aiAnalyses      TradingAiAnalysis[]

  @@map("users")
}

model TradingAccount {
  id                    BigInt   @id @default(autoincrement())
  userId                BigInt   @map("user_id")
  name                  String
  broker                String?
  assetClass            String   @map("asset_class") // stock | crypto | forex | futures
  marketType            String   @default("spot") @map("market_type") // spot | futures
  currency              String   @default("USD")
  initialBalance        Float    @default(0) @map("initial_balance")
  riskPerTradeAmount    Float    @default(0) @map("risk_per_trade_amount")
  riskPerTradePercent   Float    @default(0) @map("risk_per_trade_percent")
  leverage              Float    @default(1) // only meaningful when marketType = "futures"
  maintenanceMarginRate Float    @default(0.005) @map("maintenance_margin_rate")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")

  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades       Trade[]
  transactions TradingAccountTransaction[]

  @@index([userId])
  @@map("trading_accounts")
}

model Trade {
  id           BigInt    @id @default(autoincrement())
  accountId    BigInt    @map("account_id")
  userId       BigInt    @map("user_id")
  symbol       String
  assetClass   String    @map("asset_class")
  direction    String // long | short
  entryPrice   Float     @map("entry_price")
  exitPrice    Float?    @map("exit_price")
  quantity     Float
  entryTime    DateTime  @map("entry_time")
  exitTime     DateTime? @map("exit_time")
  stopLoss     Float?    @map("stop_loss")
  takeProfit   Float?    @map("take_profit")
  fees         Float     @default(0)
  pnl          Float     @default(0)
  rMultiple    Float?    @map("r_multiple")
  status       String    @default("open") // open | closed
  timeframe    String? // M1, M5, M15, M30, H1, H4, D1...
  session      String    @default("unknown") // sydney | tokyo | london | newyork | unknown
  followedPlan Boolean   @default(true) @map("followed_plan")
  strategy     String? // playbook / setup name, e.g. "Breakout", "Pullback"
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  account        TradingAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  executionScore TradeExecutionScore?
  errorTags      TradeErrorTagMap[]

  @@index([userId])
  @@index([accountId])
  @@index([entryTime])
  @@map("trades")
}

model TradeExecutionScore {
  tradeId         BigInt @id @map("trade_id")
  beforeScore     Float  @default(0) @map("before_score") // out of 25
  duringScore     Float  @default(0) @map("during_score") // out of 35
  afterScore      Float  @default(0) @map("after_score") // out of 20
  disciplineScore Float  @default(0) @map("discipline_score") // out of 20
  quadrant        String @default("plan_win") // plan_win | plan_loss | impulse_loss | impulse_win

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("trade_execution_scores")
}

model TradeErrorTag {
  id       BigInt @id @default(autoincrement())
  userId   BigInt @map("user_id")
  name     String
  severity Int    @default(1) // 1-3

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades TradeErrorTagMap[]

  @@index([userId])
  @@map("trade_error_tags")
}

model TradeErrorTagMap {
  tradeId    BigInt @map("trade_id")
  errorTagId BigInt @map("error_tag_id")

  trade    Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  errorTag TradeErrorTag @relation(fields: [errorTagId], references: [id], onDelete: Cascade)

  @@id([tradeId, errorTagId])
  @@map("trade_error_tag_map")
}

model TradingAccountTransaction {
  id         BigInt   @id @default(autoincrement())
  accountId  BigInt   @map("account_id")
  type       String // deposit | withdraw
  amount     Float
  occurredAt DateTime @default(now()) @map("occurred_at")
  note       String?

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("trading_account_transactions")
}

// Inputs the AI analysis needs beyond raw trades: total capital, risk
// tolerance, goals. Singleton per user.
model TradingProfileSettings {
  userId                 BigInt   @id @map("user_id")
  totalCapital           Float?   @map("total_capital")
  riskTolerance          String?  @default("medium") @map("risk_tolerance") // low | medium | high
  tradingGoal            String?  @map("trading_goal")
  preferredMarkets       String[] @default([]) @map("preferred_markets")
  maxDailyLossPercent    Float?   @map("max_daily_loss_percent")
  maxRiskPerTradePercent Float?   @map("max_risk_per_trade_percent")
  updatedAt              DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trading_profile_settings")
}

// History of AI-generated analyses (trading method / capital management /
// trading plan recommendations) for a user over a given period.
model TradingAiAnalysis {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             BigInt    @map("user_id")
  periodStart        DateTime? @map("period_start") @db.Date
  periodEnd          DateTime? @map("period_end") @db.Date
  analysisType       String    @default("full") @map("analysis_type") // full | risk_management | trading_plan | quick
  inputStats         Json      @default("{}") @map("input_stats")
  summary            String?
  riskManagementPlan Json?     @map("risk_management_plan")
  tradingPlan        Json?     @map("trading_plan")
  recommendations    Json?     @default("[]")
  model              String?
  status             String    @default("completed") // pending | completed | failed
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("trading_ai_analyses")
}
