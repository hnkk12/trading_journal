# Shared hkfin Supabase Postgres DB (this app owns none of the connection
# details — copy the pooled connection string from Supabase project settings
# that hkfin already uses). Trading-journal-specific tables live alongside
# hkfin's own tables, applied via D:\hkfin\agent\migrations\004_trading_journal.sql
DATABASE_URL="postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true"

# Must match hkfin's agent/.env JWT_SECRET_KEY exactly — this app has no
# login of its own, it only verifies the JWT hkfin already issued.
JWT_SECRET_KEY="same-value-as-hkfin-agent-.env"

PORT=4000
